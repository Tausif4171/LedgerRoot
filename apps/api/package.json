{
  "name": "@ledgerroot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entrypoints/server.ts",
    "worker": "tsx src/entrypoints/worker.ts",
    "dispatcher": "tsx src/entrypoints/dispatcher.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "tsx src/entrypoints/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@ledgerroot/contracts": "0.1.0",
    "@ledgerroot/domain": "0.1.0",
    "@prisma/client": "6.19.2",
    "better-auth": "^1.4.18",
    "bullmq": "^5.69.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.2",
    "supertest": "^7.2.2"
  }
}
